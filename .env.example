# PayPal sandbox REST credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Leave both blank to stay in mock mode. Mock mode never calls PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# mock | sandbox
# Unset: sandbox when both credentials above are present, otherwise mock.
# PAYPAL_MODE=mock

# Required to verify real webhook signatures while PAYPAL_MODE=sandbox.
# Point the sandbox webhook at https://<your-host>/api/paypal/webhook
# Events: CHECKOUT.ORDER.APPROVED, CHECKOUT.ORDER.COMPLETED,
#         PAYMENT.CAPTURE.COMPLETED, INVOICING.INVOICE.PAID
PAYPAL_WEBHOOK_ID=

# Public origin PayPal redirects back to. No trailing slash.
APP_URL=http://localhost:3000

# Vercel AI Gateway key. When this is empty (and AI_MODE is not "gateway"),
# the app uses the labelled heuristic parser and does not call a model.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Provider/model id sent through the AI Gateway. Default: openai/gpt-5.4-mini
# AI_MODEL=openai/gpt-5.4-mini

# mock | gateway
# Unset: gateway when AI_GATEWAY_API_KEY is present, otherwise mock.
# AI_MODE=mock

# Optional shared store so a Vercel deployment and its webhooks see the same charges.
# Without these, state lives in process memory (fine for `next dev` / `next start`).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Used only by `npm run demo:record` when it drives a real sandbox checkout.
# PAYPAL_SANDBOX_BUYER_EMAIL=
# PAYPAL_SANDBOX_BUYER_PASSWORD=
